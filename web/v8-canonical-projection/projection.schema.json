{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publication-intelligence.example/schemas/ohfr-v8-canonical-web-projection-v1.json",
  "title": "OHFR V8 canonical web projection",
  "type": "object",
  "required": [
    "schema_version",
    "projection_id",
    "projection_role",
    "evaluation_id",
    "view_selection",
    "score_views",
    "correction_outcomes",
    "item_summaries",
    "collections",
    "provenance",
    "public_safety",
    "limitations",
    "projection_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ohfr-v8-canonical-web-projection-v1"
    },
    "projection_id": {
      "type": "string",
      "pattern": "^OHFR-V8-WEB-[A-F0-9]{12}$"
    },
    "projection_role": {
      "const": "deterministic_public_safe_display_projection"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "view_selection": {
      "type": "object",
      "required": [
        "authoritative_view_id",
        "primary_view_id",
        "default_display_view_id",
        "display_view_rationale"
      ],
      "properties": {
        "authoritative_view_id": { "const": "canonical_as_delivered" },
        "primary_view_id": { "const": "canonical_as_delivered" },
        "default_display_view_id": { "const": "representation_adjusted" },
        "display_view_rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "score_views": {
      "type": "object",
      "required": [
        "canonical_source_adjustment_status",
        "projection_adjustment_status",
        "total_delta",
        "views"
      ],
      "properties": {
        "canonical_source_adjustment_status": { "const": "none" },
        "projection_adjustment_status": {
          "const": "confirmed_representation_adjustment_applied"
        },
        "total_delta": { "const": 0 },
        "views": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/observedView" },
            { "$ref": "#/$defs/adjustedView" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "correction_outcomes": {
      "type": "object",
      "required": [
        "affected_headings",
        "character_replacements",
        "corrected_cross_reference_id",
        "remaining_unresolved_cross_reference_id",
        "observed_minor_defect_count",
        "adjusted_minor_defect_count",
        "cross_reference_gate_unchanged",
        "readiness_unchanged"
      ],
      "properties": {
        "affected_headings": { "const": 14 },
        "character_replacements": { "const": 18 },
        "corrected_cross_reference_id": { "const": "XREF-9A63B6DC42BB" },
        "remaining_unresolved_cross_reference_id": { "const": "XREF-6E6F54660707" },
        "observed_minor_defect_count": { "const": 4 },
        "adjusted_minor_defect_count": { "const": 3 },
        "cross_reference_gate_unchanged": { "const": true },
        "readiness_unchanged": { "const": true }
      },
      "additionalProperties": false
    },
    "item_summaries": {
      "type": "object",
      "required": ["observed", "adjusted"]
    },
    "collections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/collectionBinding" }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifacts",
        "source_sha256",
        "benchmark_sha256",
        "judgment_policy_sha256",
        "rubric_version",
        "dimension_calculation_profile",
        "projection_metadata_sha256",
        "calculation_sha256",
        "correction_overlay_sha256"
      ]
    },
    "public_safety": {
      "type": "object",
      "required": [
        "source_excerpts_included",
        "restricted_files_included",
        "private_layout_evidence_included",
        "absolute_paths_included",
        "source_subject_summaries_are_synthesized_not_quoted"
      ],
      "properties": {
        "source_excerpts_included": { "const": false },
        "restricted_files_included": { "const": false },
        "private_layout_evidence_included": { "const": false },
        "absolute_paths_included": { "const": false },
        "source_subject_summaries_are_synthesized_not_quoted": { "const": true }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "projection_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scorecardRow": {
      "type": "object",
      "required": [
        "dimension_id",
        "rating",
        "awarded_points",
        "maximum_points",
        "formula_id"
      ],
      "properties": {
        "dimension_id": { "type": "string" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "awarded_points": { "type": "number", "minimum": 0 },
        "maximum_points": { "type": "number", "minimum": 0 },
        "formula_id": { "type": "string", "minLength": 1 },
        "rating_delta": { "type": "number" },
        "points_delta": { "type": "number" }
      },
      "additionalProperties": false
    },
    "baseView": {
      "type": "object",
      "required": [
        "view_id",
        "label",
        "view_kind",
        "role",
        "score",
        "maximum",
        "scorecard",
        "critical_gates",
        "readiness",
        "provenance_artifacts"
      ],
      "properties": {
        "view_id": { "type": "string" },
        "label": { "type": "string" },
        "view_kind": { "type": "string" },
        "role": { "type": "string" },
        "score": { "type": "number" },
        "maximum": { "const": 100 },
        "score_delta": { "type": "number" },
        "scorecard": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/scorecardRow" }
        },
        "critical_gates": { "type": "array" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "provenance_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactBinding" }
        },
        "gate_outcomes_equal_to_observed": { "type": "boolean" },
        "readiness_equal_to_observed": { "type": "boolean" },
        "score_stability_reason": { "type": "string" },
        "adjusted_diagnostics": { "type": "object" }
      },
      "additionalProperties": false
    },
    "observedView": {
      "allOf": [
        { "$ref": "#/$defs/baseView" },
        {
          "properties": {
            "view_id": { "const": "canonical_as_delivered" },
            "view_kind": { "const": "observed" },
            "role": { "const": "authoritative_primary_observation" },
            "score": { "const": 89.38 }
          }
        }
      ]
    },
    "adjustedView": {
      "allOf": [
        { "$ref": "#/$defs/baseView" },
        {
          "required": [
            "score_delta",
            "gate_outcomes_equal_to_observed",
            "readiness_equal_to_observed",
            "score_stability_reason",
            "adjusted_diagnostics"
          ],
          "properties": {
            "view_id": { "const": "representation_adjusted" },
            "view_kind": { "const": "counterfactual_display" },
            "role": { "const": "default_display_secondary_counterfactual" },
            "score": { "const": 89.38 },
            "score_delta": { "const": 0 },
            "gate_outcomes_equal_to_observed": { "const": true },
            "readiness_equal_to_observed": { "const": true }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "triggered_gate_ids",
        "cross_reference_gate_remains_triggered",
        "reason"
      ],
      "properties": {
        "status": { "const": "not_publication_ready" },
        "triggered_gate_ids": { "type": "array", "items": { "type": "string" } },
        "cross_reference_gate_remains_triggered": { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifactBinding": {
      "type": "object",
      "required": ["artifact_path", "sha256", "availability"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "availability": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "collectionBinding": {
      "type": "object",
      "required": [
        "collection_id",
        "artifact_path",
        "count",
        "content_sha256",
        "file_sha256"
      ],
      "properties": {
        "collection_id": {
          "enum": ["correction_overlay", "index_records", "source_subjects", "density"]
        },
        "artifact_path": { "type": "string", "pattern": "^data/.+\\.json$" },
        "count": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" },
        "file_sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
